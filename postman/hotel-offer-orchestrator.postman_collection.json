{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Tests for GET /api/hotels, price filtering, supplier failure handling, and /health.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Happy paths",
      "item": [
        {
          "name": "Delhi - overlapping hotels, cheapest wins",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is an array', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('each hotel name appears once', () => {",
                  "  const names = body.map(h => h.name.toLowerCase());",
                  "  pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "pm.test('Holtin: Supplier B (5340) beats Supplier A (6000)', () => {",
                  "  const h = body.find(x => x.name === 'Holtin');",
                  "  pm.expect(h).to.include({ price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
                  "});",
                  "pm.test('Radison: Supplier A (5900) beats Supplier B (6100)', () => {",
                  "  const h = body.find(x => x.name === 'Radison');",
                  "  pm.expect(h).to.include({ price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
                  "});",
                  "pm.test('hotels only in one supplier are kept', () => {",
                  "  pm.expect(body.map(h => h.name)).to.include.members(['Lemon Tree', 'Oberoi']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delhi - price range 5000-6000 (filtered in Redis)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=6000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "5000"
                },
                {
                  "key": "maxPrice",
                  "value": "6000"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('all prices within range', () => body.forEach(h => pm.expect(h.price).to.be.within(5000, 6000)));",
                  "pm.test('expected hotels', () => pm.expect(body.map(h => h.name)).to.have.members(['Lemon Tree', 'Holtin', 'Radison']));"
                ]
              }
            }
          ]
        },
