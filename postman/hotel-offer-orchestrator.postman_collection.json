    {
      "name": "Supplier failure simulation (run in order)",
      "item": [
        {
          "name": "1. Take Supplier A down",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/A/down",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "suppliers",
                "A",
                "down"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier A is down', () => pm.expect(pm.response.json().down).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Delhi with Supplier A down -> served by Supplier B only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK (graceful degradation)', () => pm.response.to.have.status(200));",
                  "pm.test('X-Degraded-Suppliers header names Supplier A', () => pm.expect(pm.response.headers.get('X-Degraded-Suppliers')).to.eql('Supplier A'));",
                  "pm.test('only Supplier B offers returned', () => pm.response.json().forEach(h => pm.expect(h.supplier).to.eql('Supplier B')));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Health while Supplier A is down -> degraded",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with degraded status', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql('degraded');",
                  "  pm.expect(b.checks.supplierA.status).to.eql('down');",
                  "  pm.expect(b.checks.supplierB.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ]
        },
